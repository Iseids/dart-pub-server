# REQUIRED: Change to the final publicly reachable URL, including https://.
# All download, upload, and finalize URLs are generated from this value.
PUBLIC_BASE_URL=https://pub.iseids.com

# true: everyone can download packages, but only authenticated publishers can upload.
# false: downloading also requires a read/publish token over HTTPS.
PUBLIC_READS=true

# Maximum gzip archive size accepted from dart pub publish.
MAX_UPLOAD_MB=32

# Optional logging: error, warn, info, debug
RUST_LOG=info

# First-run admin account. If ADMIN_INITIAL_PASSWORD is unset, the server
# saves a generated one-time password to /data/admin-initial-password.
ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
